datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum AssetType {
  COMMERCIAL
  RESIDENTIAL
  PLOTS
}

enum AssetStatus {
  UPCOMING
  ACTIVE
  FULLY_FUNDED
  EXITED
}

enum KycStatus {
  PENDING
  VERIFIED
  REJECTED
}

model User {
  id            String         @id @default(uuid())
  email         String         @unique
  fullName      String?
  walletAddress String?        @unique
  kycStatus     KycStatus      @default(PENDING)
  investments   Investment[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model Property {
  id              String        @id @default(uuid())
  title           String
  location        String
  type            AssetType
  status          AssetStatus   @default(ACTIVE)
  targetValuation Decimal       @db.Decimal(12, 2)
  tokenPrice      Decimal       @db.Decimal(10, 2)
  totalTokens     Int
  availableTokens Int
  expectedYield   Decimal       @db.Decimal(5, 2)
  spvName         String
  contractAddress String?
  investments     Investment[]
  rentalPayouts   RentalPayout[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

model Investment {
  id          String    @id @default(uuid())
  userId      String
  propertyId  String
  tokenCount  Int
  amountPaid  Decimal   @db.Decimal(12, 2)
  user        User      @relation(fields: [userId], references: [id])
  property    Property  @relation(fields: [propertyId], references: [id])
  createdAt   DateTime  @default(now())
}

model RentalPayout {
  id          String    @id @default(uuid())
  propertyId  String
  totalAmount Decimal   @db.Decimal(12, 2)
  payoutDate  DateTime  @default(now())
  property    Property  @relation(fields: [propertyId], references: [id])
}
